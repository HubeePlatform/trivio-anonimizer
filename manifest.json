{
  "manifest_version": 3,
  "name": "Anonimizador",
  "version": "1.1.0",
  "description": "Oculta dados sensíveis em qualquer site para gravação de vídeos e apresentações",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anonimizador"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
